{
  "compilerOptions": {
    "rootDir": "./",
    "paths": {
      "@renderer/*": ["./src/renderer/*"],
      "@static/*": ["./src/static/*"],
      "@common/*": ["./src/common/*"]
    }
  },
  "vueCompilerOptions": {
    "plugins": [
      "@vue/language-plugin-pug"
    ]
  },
  "exclude": ["node_modules", "build", "dist"]
}
