{
  "name": "tuneflow-server-web",
  "version": "2.13.3",
  "description": "TuneFlow (音流) Web UI and Node.js Service",
  "scripts": {
    "build:theme": "node src/common/theme/createThemes.js",
    "dev:web": "cross-env NODE_ENV=development webpack serve --config build-config/renderer-web/webpack.config.dev.js",
    "build:web": "cross-env NODE_ENV=production webpack --config build-config/renderer-web/webpack.config.prod.js",
    "build:server": "node build-config/server/build.mjs",
    "prepare:service": "npm run build:server && node build-config/server/prepare.mjs",
    "verify:service-runtime": "node build-config/server/verify-native-runtimes.mjs",
    "verify:service-isolated": "node build-config/server/verify-isolated-package.mjs",
    "fingerprint:worktree": "node build-config/server/worktree-fingerprint.mjs",
    "build:service": "npm run build:web && npm run prepare:service",
    "dev:server": "npm run prepare:service && cross-env TUNEFLOW_SERVICE_NODE_MODULES=./dist/server/node_modules node dist/server/index.cjs",
    "start:server": "node dist/server/index.cjs",
    "migrate:storage": "node dist/server/migrate-storage.cjs",
    "lint": "eslint --ext .ts,.js,.vue -f stylish src",
    "lint:fix": "eslint --ext .ts,.js,.vue -f stylish --fix src",
    "test": "npm run test:unit && npm run test:build-config",
    "test:unit": "npm run build:service && vitest run",
    "test:build-config": "node --test build-config/server/*.test.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "engines": {
    "node": ">= 24",
    "npm": ">=8.5.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appdev/TuneFlow.git"
  },
  "keywords": [
    "music-player",
    "web",
    "server",
    "vuejs3"
  ],
  "author": "TuneFlow contributors",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/appdev/TuneFlow/issues"
  },
  "homepage": "https://github.com/appdev/TuneFlow#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tsconfig/recommended": "^1.0.13",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/needle": "^3.3.0",
    "@types/node": "^24.13.3",
    "@types/tunnel": "^0.0.7",
    "@vue/language-plugin-pug": "^3.2.7",
    "adm-zip": "0.6.0",
    "browserslist": "^4.28.2",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.49.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-vue": "^9.33.0",
    "eslint-plugin-vue-pug": "^0.6.2",
    "eslint-webpack-plugin": "^4.2.0",
    "html-webpack-plugin": "^5.6.7",
    "less": "^4.6.4",
    "less-loader": "^12.3.2",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.12",
    "postcss-loader": "^8.2.1",
    "postcss-pxtorem": "^6.1.0",
    "pug": "^3.0.4",
    "pug-plain-loader": "^1.1.0",
    "svg-sprite-loader": "^6.0.11",
    "svg-transform-loader": "^2.0.13",
    "svgo-loader": "^5.0.0",
    "terser": "^5.46.2",
    "terser-webpack-plugin": "^5.5.0",
    "ts-loader": "^9.5.7",
    "tsx": "^4.23.11",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^9.4.3",
    "vue-loader": "^17.4.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "5.2.3",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@simonwep/pickr": "^1.9.1",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.3",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "fastify": "^5.11.3",
    "he": "1.2.0",
    "iconv-lite": "^0.7.2",
    "image-size": "^1.1.0",
    "jschardet": "^3.1.4",
    "music-metadata": "^11.12.3",
    "needle": "^3.5.0",
    "pako": "1.0.11",
    "qrc-decoder": "1.0.2",
    "sortablejs": "^1.15.7",
    "taglib-wasm": "^2.0.0",
    "tunnel": "^0.0.6",
    "typebox": "^1.3.12",
    "undici": "7.22.0",
    "vue": "~3.3.13",
    "vue-router": "~4.5.1"
  },
  "overrides": {
    "got": "^11",
    "json5": "latest",
    "minimatch": "latest",
    "semver": "latest",
    "posthtml": "latest",
    "svg-transform-loader": {
      "postcss": "^8"
    },
    "svg-sprite-loader": {
      "postcss": "^8"
    },
    "svg-baker": {
      "postcss": "^8"
    },
    "braces": "latest",
    "node-gyp-build": "latest",
    "micromatch": "latest",
    "http-cache-semantics": "latest"
  }
}
